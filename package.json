{
  "name": "grocery-compare",
  "version": "0.1.0",
  "private": true,
  "description": "A simple Windows shopping app for New World and Woolworths NZ",
  "author": "Steez-47",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "build": "vite build",
    "test": "node --test tests/*.test.cjs",
    "check": "tsc --noEmit",
    "package": "npm run check && npm run test && npm run build && electron-builder --win nsis --publish never"
  },
  "build": {
    "appId": "nz.grocerycompare.desktop",
    "productName": "Grocery Compare",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "assets/icon.ico"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "artifactName": "Grocery-Compare-Setup-${version}.${ext}"
    }
  },
  "dependencies": {
    "lucide-react": "^1.41.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.2"
  }
}
