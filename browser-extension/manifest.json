{
 "manifest_version":3,
 "name":"Grocery Compare Browser Companion",
 "version":"0.4.0",
 "description":"Use your own browser session for Grocery Compare cart handoff.",
 "permissions":["storage","scripting","alarms"],
 "host_permissions":["http://127.0.0.1/*","https://www.newworld.co.nz/*","https://api-prod.newworld.co.nz/*","https://www.woolworths.co.nz/*"],
 "background":{"service_worker":"background.js"},
 "content_scripts":[{"matches":["http://127.0.0.1/*"],"js":["connect.js"]}],
 "action":{"default_title":"Grocery Compare","default_popup":"popup.html"}
}
